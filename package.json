{
  "name": "dwm-clip",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3414",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "engine": "cd engine && ./run-local.sh",
    "cf:build": "opennextjs-cloudflare build",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:local": "wrangler d1 migrations apply dwm-clip --local",
    "db:remote": "wrangler d1 migrations apply dwm-clip --remote"
  },
  "dependencies": {
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@opennextjs/cloudflare": "^1.20.16",
    "lucide-react": "^1.67.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@tailwindcss/postcss": "^4.3.4",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "wrangler": "^4.158.0"
  }
}
