{
  "$schema": "node_modules/wrangler/config-schema.json",
  // DWM Clip on Cloudflare Workers (pages built by OpenNext), database on D1, clips on R2.
  // Deploy with `npm run cf:deploy`. The clip engine (engine/) runs separately; ENGINE_URL points at it.
  "name": "dwm-clip",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "routes": [{ "pattern": "clip.dealwithmuhammad.com", "custom_domain": true }],
  "d1_databases": [{ "binding": "DB", "database_name": "dwm-clip", "database_id": "37d5060e-38cf-42ff-a6f7-447c8600dedc", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "dwm-clip-media" }],
  "vars": {
    "SMTP_HOST": "smtp.gmail.com",
    "SMTP_FROM": "me@dealwithmuhammad.com",
    // "Our AI" for Pro: the cheapest model that still picks good moments.
    "AI_PROVIDER": "gemini",
    "AI_MODEL": "gemini-3.5-flash-lite,gemini-2.5-flash-lite",
    // Which service takes payments: "lemonsqueezy" now, "paddle" once Paddle has approved the site.
    "PAYMENTS": "lemonsqueezy",
    // Lemon Squeezy (store "DWM Invite"): each product's checkout link and id. Not secret.
    "LEMONSQUEEZY_LINK_LITE": "https://pay.dealwithmuhammad.com/checkout/buy/423f1d71-fd6e-47a7-a0e2-a9dc37e685ea",
    "LEMONSQUEEZY_LINK_PRO": "https://pay.dealwithmuhammad.com/checkout/buy/c0916888-e829-4001-89c5-3f59382cf176",
    "LEMONSQUEEZY_LINK_STORAGE": "https://pay.dealwithmuhammad.com/checkout/buy/8cf02f31-100d-4b21-aad7-50edf7b3fd86",
    "LEMONSQUEEZY_PRODUCT_LITE": "1533120",
    "LEMONSQUEEZY_PRODUCT_PRO": "1533076",
    "LEMONSQUEEZY_PRODUCT_STORAGE": "1533077",
    // Paddle (live account, seller 250501). None of these are secret.
    "PADDLE_PRICE_PRO": "pri_01m7nhv6fjjfddgywjn8pfxb5s",
    "PADDLE_PRICE_STORAGE": "pri_01m7nhy71415w5etdh0d4t9qns",
    "PADDLE_PORTAL_URL": "https://customer-portal.paddle.com/cpl_01k3zb44pd51y2bfaz2191rvsz"
    // Add this line (with a comma above) once Paddle has approved clip.dealwithmuhammad.com and verified
    // the account. Until then the pay buttons stay off, because the checkout would only show an error.
    // "PADDLE_CLIENT_TOKEN": "live_5b09ac294d15531687be34f4b72"
  }
  // Secrets (set once with `npx wrangler secret put NAME`):
  //   ADMIN_EMAILS                   who may open /admin (comma separated)
  //   SESSION_SECRET                 signs sign-in cookies and locks saved AI keys; any long random string
  //   SMTP_USER, SMTP_PASS           the Gmail address + app password that send sign-in codes
  //   AI_KEY                         the Gemini key used for Pro members
  //   ENGINE_URL, ENGINE_SECRET      where the clip engine runs, and the password it shares with this site
  //   LEMONSQUEEZY_WEBHOOK_SECRET    the signing secret of the Lemon Squeezy webhook that points at
  //                                  https://clip.dealwithmuhammad.com/api/billing/lemonsqueezy
  //   PADDLE_WEBHOOK_SECRET          the secret key of the "DWM Clip subscriptions" webhook in Paddle
  //                                  (Events → Notifications); see src/lib/server/billing.ts
}
